#!/usr/bin/env bash
# Add a DCO Signed-off-by trailer to the commit message.
# Existing trailers are left in their original order.
set -euo pipefail

message_file="$1"
commit_source="${2:-}"

# Merge commits are generated by Git; do not rewrite their messages.
if [[ "$commit_source" == "merge" ]]; then
  exit 0
fi

name="$(git config user.name || true)"
email="$(git config user.email || true)"
if [[ -z "$name" || -z "$email" ]]; then
  echo "Error: git user.name and user.email must be configured for DCO sign-off." >&2
  exit 1
fi

existing_trailers="$(git interpret-trailers --parse "$message_file")"
if printf '%s\n' "$existing_trailers" | grep -q '^Signed-off-by: '; then
  exit 0
fi

tmp_file="$(mktemp)"
trap 'rm -f "$tmp_file"' EXIT

awk -v signoff="Signed-off-by: ${name} <${email}>" '
  { lines[NR] = $0 }
  END {
    if (NR == 0) {
      print signoff
      exit
    }
    last_blank = 0
    for (i = 1; i <= NR; i++) {
      if (lines[i] == "") last_blank = i
    }
    start = last_blank + 1
    if (start <= NR && lines[start] ~ /^[A-Za-z][A-Za-z0-9-]*: /) {
      for (i = 1; i < start; i++) print lines[i]
      print signoff
      for (i = start; i <= NR; i++) print lines[i]
    } else {
      for (i = 1; i <= NR; i++) print lines[i]
      if (last_blank != NR) print ""
      print signoff
    }
  }
' "$message_file" > "$tmp_file"
mv "$tmp_file" "$message_file"
trap - EXIT
